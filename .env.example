# .env.example
# Copy this file to .env and fill in the values.

# Backend (learnnov-cloud) configuration
POSTGRES_DB=learnnov
POSTGRES_USER=learnnov_user
POSTGRES_PASSWORD=secure_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# Django secret key (generate a strong one)
DJANGO_SECRET_KEY=changeme_secure_secret_key

# Debug mode (True for dev, False for prod)
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Additional optional settings
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@example.com
# EMAIL_HOST_PASSWORD=your_email_password
# EMAIL_USE_TLS=True

# Front‑end (openedx) environment variables (if any)
# OPENEDX_ENV=development
