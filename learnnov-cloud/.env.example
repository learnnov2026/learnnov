# LearnNov Cloud — Environment Variables Example
# Copy this to .env (but do not commit .env to Git)

SECRET_KEY=generate-a-secure-random-key-here
DEBUG=False
ALLOWED_HOSTS=learnnov.onrender.com,localhost,127.0.0.1

# Database (Render will provide this automatically via DATABASE_URL)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# HyperPay (Optional)
HYPERPAY_ACCESS_TOKEN=...
HYPERPAY_ENTITY_VISA=...
HYPERPAY_ENTITY_MADA=...
HYPERPAY_BASE_URL=https://eu-test.oppwa.com

# Firebase / AWS
FIREBASE_SECRET_KEY=...
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Zoom
ZOOM_API_KEY=...
ZOOM_API_SECRET=...
ZOOM_WEBHOOK_SECRET=...

# Redis Cache (Optional - defaults to local memory cache if empty)
# REDIS_URL=redis://127.0.0.1:6379/0

# MongoDB (Optional - NoSQL database for AI Chat logs, falls back to SQL if empty)
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DB_NAME=learnnov
